#!/usr/bin/env bash
# agent — launch or attach to a named Copilot, Claude, or Codex session
#
# The canonical command selects a backend explicitly. The three long aliases
# select it from their invocation name:
#   agent-stack <copilot|claude|codex> <name>
#   copilot-agent <name>
#   claude-agent <name>
#   codex-agent <name>
#
# Each backend has a separate workspace root and tmux namespace.
#
# Configuration (env or ~/.config/remote-agent-stack/config):
#   COPILOT_WORKSPACE_BASE   default: ~/Library/CloudStorage/Dropbox/copilot-workspace
#   CLAUDE_WORKSPACE_BASE    default: ~/Library/CloudStorage/Dropbox/claude-workspace
#   CODEX_WORKSPACE_BASE     default: ~/Library/CloudStorage/Dropbox/codex-workspace
#   COPILOT_BIN              default: copilot
#   CLAUDE_BIN               default: claude
#   CODEX_BIN                default: codex
#   AGENT_DIR_PREFIX         default: agent-
#   COPILOT_TASK_WAIT_TIMEOUT_SECONDS
#                            default: 3600
#   ALLOW_ALL                default: false
#     copilot: --allow-all
#     claude : --dangerously-skip-permissions
#     codex  : --dangerously-bypass-approvals-and-sandbox
#   MAILBOX_INTEGRATION      default: false
#   MAILBOX_SCRIPTS_DIR      optional absolute mailbox scripts directory
#   SESSION_WARN_MB          default: 300  (copilot only; 0 disables)
#     Offer to retire a session whose event log has grown past this size.

set -euo pipefail

codex_mailbox_cleanup() {
  trap - EXIT INT TERM HUP
  for _pid in "${CODEX_MONITOR_PID:-}" "${CODEX_TUI_PID:-}" "${CODEX_WATCHER_PID:-}" "${CODEX_SERVER_PID:-}"; do
    [ -n "$_pid" ] || continue
    kill "$_pid" 2>/dev/null || true
  done
  for _pid in "${CODEX_MONITOR_PID:-}" "${CODEX_TUI_PID:-}" "${CODEX_WATCHER_PID:-}" "${CODEX_SERVER_PID:-}"; do
    [ -n "$_pid" ] || continue
    wait "$_pid" 2>/dev/null || true
  done
}

monitor_codex_mailbox_children() {
  local launcher_pid="$1" tui_pid="$2" server_pid="$3" watcher_pid="$4"
  local pane_identity
  while kill -0 "$launcher_pid" 2>/dev/null; do
    if [ -n "${TMUX_PANE:-}" ]; then
      pane_identity="$(
        tmux display-message -p -t "$TMUX_PANE" '#{pane_id}' 2>/dev/null || true
      )"
      if [ "$pane_identity" != "$TMUX_PANE" ]; then
        kill "$tui_pid" "$watcher_pid" "$server_pid" 2>/dev/null || true
        kill "$launcher_pid" 2>/dev/null || true
        return 1
      fi
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
      echo "agent-stack: managed Codex app-server exited; stopping its clients." >&2
      kill "$tui_pid" "$watcher_pid" 2>/dev/null || true
      kill "$launcher_pid" 2>/dev/null || true
      return 1
    fi
    if ! kill -0 "$watcher_pid" 2>/dev/null; then
      echo "agent-stack: managed Codex mailbox watcher exited; stopping the session." >&2
      kill "$tui_pid" "$server_pid" 2>/dev/null || true
      kill "$launcher_pid" 2>/dev/null || true
      return 1
    fi
    kill -0 "$tui_pid" 2>/dev/null || return 0
    sleep 0.2
  done
}

inspect_codex_listener() {
  local pid="$1"
  if [ -n "${CODEX_LISTENER_INSPECTOR:-}" ]; then
    "$CODEX_LISTENER_INSPECTOR" "$pid"
    return
  fi
  /usr/sbin/lsof -nP -a -p "$pid" -iTCP -sTCP:LISTEN -F n 2>/dev/null |
    awk 'substr($0, 1, 1) == "n" { print substr($0, 2) }'
}

run_codex_mailbox_launcher() {
  [ $# -eq 7 ] || {
    echo "agent-stack: invalid managed Codex launch." >&2
    return 2
  }
  local codex_bin="$1" node_bin="$2" watcher="$3" workspace="$4"
  local self_address="$5" allow_all="$6" has_session="$7"
  local token token_hash listeners listener endpoint="" count attempt
  local tui_status tui_job
  local max_attempts="${CODEX_LISTENER_ATTEMPTS:-100}"
  local retry_delay="${CODEX_LISTENER_DELAY_SECONDS:-0.1}"

  token="$(
    if [ -n "${CODEX_TOKEN_GENERATOR:-}" ]; then
      "$CODEX_TOKEN_GENERATOR"
    else
      "$node_bin" -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))'
    fi
  )"
  [ -n "$token" ] && [ "${token#*$'\n'}" = "$token" ] || {
    echo "agent-stack: could not create the managed Codex capability." >&2
    return 1
  }
  token_hash="$(printf '%s' "$token" | /usr/bin/shasum -a 256 | awk '{print $1}')"
  [ -n "$token_hash" ] || {
    echo "agent-stack: could not hash the managed Codex capability." >&2
    return 1
  }

  CODEX_SERVER_PID=""
  CODEX_WATCHER_PID=""
  CODEX_TUI_PID=""
  CODEX_MONITOR_PID=""
  trap codex_mailbox_cleanup EXIT
  trap 'exit 130' INT TERM HUP

  MAILBOX_SELF_ADDRESS="$self_address" \
  "$codex_bin" app-server \
    --listen ws://127.0.0.1:0 \
    --ws-auth capability-token \
    --ws-token-sha256 "$token_hash" </dev/null >/dev/null 2>&1 &
  CODEX_SERVER_PID=$!

  attempt=0
  while [ "$attempt" -lt "$max_attempts" ]; do
    kill -0 "$CODEX_SERVER_PID" 2>/dev/null || {
      echo "agent-stack: managed Codex app-server exited before binding loopback." >&2
      return 1
    }
    listeners="$(inspect_codex_listener "$CODEX_SERVER_PID" || true)"
    count=0
    endpoint=""
    while IFS= read -r listener; do
      [ -n "$listener" ] || continue
      count=$((count + 1))
      if printf '%s\n' "$listener" | grep -Eq '^127\.0\.0\.1:[0-9]+$'; then
        endpoint="ws://$listener"
      else
        endpoint=""
      fi
    done <<EOF
$listeners
EOF
    if [ "$count" -eq 1 ] && [ -n "$endpoint" ]; then
      break
    fi
    if [ "$count" -gt 0 ]; then
      echo "agent-stack: managed Codex listener ownership is ambiguous; no client started." >&2
      return 1
    fi
    attempt=$((attempt + 1))
    sleep "$retry_delay"
  done
  if [ -z "$endpoint" ]; then
    echo "agent-stack: managed Codex loopback listener was not proven; no client started." >&2
    return 1
  fi
  kill -0 "$CODEX_SERVER_PID" 2>/dev/null || {
    echo "agent-stack: managed Codex app-server exited after listener discovery." >&2
    return 1
  }

  MAILBOX_SELF_ADDRESS="$self_address" \
  CODEX_APP_SERVER_ENDPOINT="$endpoint" \
  CODEX_APP_SERVER_TOKEN="$token" \
  CODEX_WORKSPACE="$workspace" \
  CODEX_LAUNCHER_PID="$$" \
  CODEX_ALLOW_ALL="$allow_all" \
    "$node_bin" "$watcher" </dev/null &
  CODEX_WATCHER_PID=$!
  sleep 0.1
  kill -0 "$CODEX_WATCHER_PID" 2>/dev/null || {
    echo "agent-stack: managed Codex mailbox watcher did not start." >&2
    return 1
  }

  [ -t 0 ] && set -m
  if [ "$has_session" = "true" ]; then
    MAILBOX_SELF_ADDRESS="$self_address" \
    CODEX_AGENT_STACK_REMOTE_TOKEN="$token" \
      "$codex_bin" resume --last --cd "$workspace" \
      --remote "$endpoint" \
      --remote-auth-token-env CODEX_AGENT_STACK_REMOTE_TOKEN &
  else
    MAILBOX_SELF_ADDRESS="$self_address" \
    CODEX_AGENT_STACK_REMOTE_TOKEN="$token" \
      "$codex_bin" -c ephemeral=false --cd "$workspace" \
      --remote "$endpoint" \
      --remote-auth-token-env CODEX_AGENT_STACK_REMOTE_TOKEN &
  fi
  CODEX_TUI_PID=$!

  if [ -t 0 ]; then
    tui_job="$(
      jobs -l |
        awk -v pid="$CODEX_TUI_PID" '
          $2 == pid {
            job = $1
            gsub(/[^0-9]/, "", job)
            print job
            exit
          }'
    )"
    [ -n "$tui_job" ] || {
      echo "agent-stack: could not foreground the managed Codex TUI." >&2
      return 1
    }
    monitor_codex_mailbox_children \
      "$$" "$CODEX_TUI_PID" "$CODEX_SERVER_PID" "$CODEX_WATCHER_PID" &
    CODEX_MONITOR_PID=$!
    set +e
    fg "%$tui_job"
    tui_status=$?
    set -e
    kill "$CODEX_MONITOR_PID" 2>/dev/null || true
    wait "$CODEX_MONITOR_PID" 2>/dev/null || true
    CODEX_MONITOR_PID=""
    set +m
    return "$tui_status"
  fi

  while :; do
    if ! kill -0 "$CODEX_SERVER_PID" 2>/dev/null; then
      echo "agent-stack: managed Codex app-server exited; stopping its clients." >&2
      return 1
    fi
    if ! kill -0 "$CODEX_WATCHER_PID" 2>/dev/null; then
      echo "agent-stack: managed Codex mailbox watcher exited; stopping the session." >&2
      return 1
    fi
    if ! kill -0 "$CODEX_TUI_PID" 2>/dev/null; then
      set +e
      wait "$CODEX_TUI_PID"
      tui_status=$?
      set -e
      return "$tui_status"
    fi
    sleep 0.2
  done
}

if [ "${1:-}" = "--internal-codex-mailbox-launch" ]; then
  shift
  run_codex_mailbox_launcher "$@"
  exit $?
fi

# ---- backend dispatch + args -----------------------------------------------

INVOCATION="$(basename "$0")"

usage_global() {
  cat <<USAGE
Usage: $INVOCATION <copilot|claude|codex> <Name>
  Launch or reattach to a named agent session.

Examples:
  $INVOCATION copilot alpha
  $INVOCATION claude alpha
  $INVOCATION codex alpha

Options:
  -h, --help   Show this help and exit.
USAGE
}

usage_backend() {
  local command
  if [ "$INVOCATION" = "agent-stack" ] || [ "$INVOCATION" = "agent" ]; then
    command="$INVOCATION $BACKEND"
  else
    command="$INVOCATION"
  fi
  cat <<USAGE
Usage: $command <Name>
  Launch or reattach to a named $BACKEND agent session.

  Example: $command alpha

Options:
  -h, --help   Show this help and exit.

Config:
  ~/.config/remote-agent-stack/config
  Env: COPILOT_WORKSPACE_BASE, CLAUDE_WORKSPACE_BASE, CODEX_WORKSPACE_BASE,
       COPILOT_BIN, CLAUDE_BIN, CODEX_BIN, AGENT_DIR_PREFIX, ALLOW_ALL,
       MAILBOX_INTEGRATION, MAILBOX_SCRIPTS_DIR,
       COPILOT_TASK_WAIT_TIMEOUT_SECONDS
USAGE
}

case "$INVOCATION" in
  agent-stack|agent)
    case "${1:-}" in
      -h|--help)
        [ $# -eq 1 ] || { usage_global >&2; exit 2; }
        usage_global
        exit 0
        ;;
      copilot|claude|codex)
        BACKEND="$1"
        shift
        ;;
      *)
        usage_global >&2
        exit 2
        ;;
    esac
    ;;
  copilot-agent) BACKEND="copilot" ;;
  claude-agent)  BACKEND="claude" ;;
  codex-agent)   BACKEND="codex" ;;
  ca|cc|co)
    echo "'$INVOCATION' is retired; use agent-stack or a descriptive backend alias." >&2
    echo "  agent-stack copilot <Name>  or  copilot-agent <Name>" >&2
    echo "  agent-stack claude <Name>   or  claude-agent <Name>" >&2
    echo "  agent-stack codex <Name>    or  codex-agent <Name>" >&2
    exit 2
    ;;
  *)
    echo "Unsupported invocation name: $INVOCATION" >&2
    INVOCATION="agent-stack"
    usage_global >&2
    exit 2
    ;;
esac

case "${1:-}" in
  -h|--help)
    [ $# -eq 1 ] || { usage_backend >&2; exit 2; }
    usage_backend
    exit 0
    ;;
esac

if [ $# -ne 1 ] || [ -z "${1:-}" ] || [ "${1#-}" != "$1" ] ||
   [ "${1#*/}" != "$1" ]; then
  usage_backend >&2
  exit 2
fi

NAME="$1"

# ---- config ----------------------------------------------------------------

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/remote-agent-stack"
CONFIG_FILE="$CONFIG_DIR/config"

COPILOT_TASK_WAIT_TIMEOUT_SECONDS_FROM_ENV=false
if [ "${COPILOT_TASK_WAIT_TIMEOUT_SECONDS+x}" = "x" ]; then
  COPILOT_TASK_WAIT_TIMEOUT_SECONDS_FROM_ENV=true
  COPILOT_TASK_WAIT_TIMEOUT_SECONDS_ENV="$COPILOT_TASK_WAIT_TIMEOUT_SECONDS"
fi

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

if [ "$COPILOT_TASK_WAIT_TIMEOUT_SECONDS_FROM_ENV" = "true" ]; then
  COPILOT_TASK_WAIT_TIMEOUT_SECONDS="$COPILOT_TASK_WAIT_TIMEOUT_SECONDS_ENV"
fi

# Pre-Claude installs used WORKSPACE_BASE for Copilot. Preserve that value so
# upgrading the script does not silently switch existing agents to a new root.
if [ -z "${COPILOT_WORKSPACE_BASE:-}" ] && [ -n "${WORKSPACE_BASE:-}" ]; then
  COPILOT_WORKSPACE_BASE="$WORKSPACE_BASE"
fi

: "${COPILOT_WORKSPACE_BASE:=$HOME/Library/CloudStorage/Dropbox/copilot-workspace}"
: "${CLAUDE_WORKSPACE_BASE:=$HOME/Library/CloudStorage/Dropbox/claude-workspace}"
: "${CODEX_WORKSPACE_BASE:=$HOME/Library/CloudStorage/Dropbox/codex-workspace}"
: "${COPILOT_BIN:=copilot}"
: "${CLAUDE_BIN:=claude}"
: "${CODEX_BIN:=codex}"
: "${AGENT_DIR_PREFIX:=agent-}"
: "${SESSION_WARN_MB:=300}"
: "${COPILOT_TASK_WAIT_TIMEOUT_SECONDS=3600}"

case "$BACKEND" in
  copilot)
    AGENT_BIN="$COPILOT_BIN"
    WORKSPACE_BASE="$COPILOT_WORKSPACE_BASE"
    SESSION_PREFIX=""
    ;;
  claude)
    AGENT_BIN="$CLAUDE_BIN"
    WORKSPACE_BASE="$CLAUDE_WORKSPACE_BASE"
    SESSION_PREFIX="claude-"
    ;;
  codex)
    AGENT_BIN="$CODEX_BIN"
    WORKSPACE_BASE="$CODEX_WORKSPACE_BASE"
    SESSION_PREFIX="codex-"
    ;;
esac

DIR="$WORKSPACE_BASE/${AGENT_DIR_PREFIX}${NAME}"
SESSION="${SESSION_PREFIX}${NAME}"
MAILBOX_SELF_ADDRESS="$BACKEND:$NAME"

# ---- preflight -------------------------------------------------------------

if [ ! -d "$WORKSPACE_BASE" ]; then
  BACKEND_UPPER="$(printf '%s' "$BACKEND" | tr a-z A-Z)"
  echo "$BACKEND workspace base not available: $WORKSPACE_BASE" >&2
  echo "Set ${BACKEND_UPPER}_WORKSPACE_BASE in $CONFIG_FILE or via env." >&2
  exit 1
fi

mkdir -p "$DIR"

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux not found in PATH. Run the remote-agent-stack installer." >&2
  exit 1
fi

if ! command -v "$AGENT_BIN" >/dev/null 2>&1; then
  echo "$BACKEND CLI ('$AGENT_BIN') not found in PATH." >&2
  exit 1
fi

# ---- mailbox poke resolver -------------------------------------------------
# Mailbox skill (dfrysinger/skills) lives in the plugin install path once
# installed; fall back to local-dev paths. Empty if not installed OR if
# MAILBOX_INTEGRATION is not set to "true" in config.

MAILBOX_POKE=""
MAILBOX_POKE_PROVIDER_AWARE=false
CLAUDE_MAILBOX_SETTINGS_ARG=""
CODEX_NATIVE_MAILBOX=false
CODEX_MAILBOX_WATCHER=""
if [ "${MAILBOX_INTEGRATION:-false}" = "true" ]; then
  if [ -n "${MAILBOX_SCRIPTS_DIR:-}" ]; then
    [ -x "$MAILBOX_SCRIPTS_DIR/mailbox-poke.sh" ] &&
      MAILBOX_POKE="$MAILBOX_SCRIPTS_DIR/mailbox-poke.sh"
  else
    for _p in \
      "$HOME/.copilot/installed-plugins/_direct/dfrysinger--skills/skills/mailbox/scripts/mailbox-poke.sh" \
      "$HOME/.claude/plugins/repos/dfrysinger/skills/skills/mailbox/scripts/mailbox-poke.sh" \
      "$HOME/code/skills/skills/mailbox/scripts/mailbox-poke.sh" \
      "$HOME/.copilot/skills/mailbox/scripts/mailbox-poke.sh"; do
      [ -x "$_p" ] && { MAILBOX_POKE="$_p"; break; }
    done
  fi
  if [ -n "$MAILBOX_POKE" ] && grep -Fq -- "--tmux-session" "$MAILBOX_POKE"; then
    MAILBOX_POKE_PROVIDER_AWARE=true
  fi
  NODE_BIN="$(command -v node 2>/dev/null || true)"

  if [ "$BACKEND" = "claude" ]; then
    CLAUDE_MAILBOX_HOOK=""
    if [ -n "${MAILBOX_SCRIPTS_DIR:-}" ]; then
      CLAUDE_MAILBOX_ROOT="$MAILBOX_SCRIPTS_DIR"
    else
      for _p in \
        "$HOME/.copilot/installed-plugins/_direct/dfrysinger--skills/skills/mailbox/scripts/claude-mailbox-hook.mjs" \
        "$HOME/.claude/plugins/marketplaces/dfrysinger-skills/skills/mailbox/scripts/claude-mailbox-hook.mjs" \
        "$HOME/code/skills/skills/mailbox/scripts/claude-mailbox-hook.mjs" \
        "$HOME/.copilot/skills/mailbox/scripts/claude-mailbox-hook.mjs"; do
        [ -f "$_p" ] && { CLAUDE_MAILBOX_ROOT="$(dirname "$_p")"; break; }
      done
    fi
    if [ -n "${CLAUDE_MAILBOX_ROOT:-}" ] &&
       [ -f "$CLAUDE_MAILBOX_ROOT/claude-mailbox-hook.mjs" ] &&
       [ -f "$CLAUDE_MAILBOX_ROOT/claude-mailbox-adapter.mjs" ] &&
       [ -f "$CLAUDE_MAILBOX_ROOT/claude-mailbox-watcher.mjs" ] &&
       [ -f "$CLAUDE_MAILBOX_ROOT/mailbox-core.mjs" ] &&
       [ -f "$CLAUDE_MAILBOX_ROOT/../../../extensions/session-control/diagnostics.mjs" ]; then
      CLAUDE_MAILBOX_HOOK="$CLAUDE_MAILBOX_ROOT/claude-mailbox-hook.mjs"
    fi
    if [ -z "$CLAUDE_MAILBOX_HOOK" ]; then
      echo "Warning: native Claude mailbox delivery is unavailable." >&2
      if [ "$MAILBOX_POKE_PROVIDER_AWARE" = "true" ] && [ -n "$NODE_BIN" ]; then
        echo "Upgrade or reinstall the dfrysinger/skills plugin; using the guarded tmux fallback." >&2
      else
        echo "Upgrade or reinstall the dfrysinger/skills plugin; mailbox envelopes will remain pending." >&2
      fi
    else
      if [ -z "$NODE_BIN" ]; then
        echo "Warning: native Claude mailbox delivery requires Node.js in PATH." >&2
        echo "Mailbox envelopes will remain pending until Node.js is available." >&2
      else
        if CLAUDE_MAILBOX_SETTINGS="$(
          python3 - "$NODE_BIN" "$CLAUDE_MAILBOX_HOOK" <<'PY'
import json
import shlex
import sys

node, hook = sys.argv[1:]
print(json.dumps({
    "hooks": {
        "SessionStart": [{
            "hooks": [{
                "type": "command",
                "command": shlex.join([node, hook]),
            }],
        }],
    },
}, separators=(",", ":")))
PY
        )"; then
          printf -v CLAUDE_MAILBOX_SETTINGS_ARG '%q' "$CLAUDE_MAILBOX_SETTINGS"
        else
          echo "Warning: native Claude mailbox settings could not be generated." >&2
          if [ "$MAILBOX_POKE_PROVIDER_AWARE" = "true" ] && [ -n "$NODE_BIN" ]; then
            echo "Using the guarded tmux fallback." >&2
          else
            echo "Mailbox envelopes will remain pending." >&2
          fi
        fi
      fi
    fi
  elif [ "$BACKEND" = "codex" ] && [ "$(uname -s)" = "Darwin" ]; then
    CODEX_MAILBOX_ROOT=""
    if [ -n "${MAILBOX_SCRIPTS_DIR:-}" ]; then
      CODEX_MAILBOX_ROOT="$MAILBOX_SCRIPTS_DIR"
    else
      for _p in \
        "$HOME/.copilot/installed-plugins/_direct/dfrysinger--skills/skills/mailbox/scripts/codex-mailbox-watcher.mjs" \
        "$HOME/.claude/plugins/marketplaces/dfrysinger-skills/skills/mailbox/scripts/codex-mailbox-watcher.mjs" \
        "$HOME/code/skills/skills/mailbox/scripts/codex-mailbox-watcher.mjs" \
        "$HOME/.copilot/skills/mailbox/scripts/codex-mailbox-watcher.mjs"; do
        [ -f "$_p" ] && { CODEX_MAILBOX_ROOT="$(dirname "$_p")"; break; }
      done
    fi
    if [ -n "$CODEX_MAILBOX_ROOT" ] &&
       [ -f "$CODEX_MAILBOX_ROOT/codex-mailbox-watcher.mjs" ] &&
       [ -f "$CODEX_MAILBOX_ROOT/codex-mailbox-adapter.mjs" ] &&
       [ -f "$CODEX_MAILBOX_ROOT/mailbox-core.mjs" ] &&
       [ -f "$CODEX_MAILBOX_ROOT/../../../extensions/session-control/diagnostics.mjs" ] &&
       [ -n "$NODE_BIN" ]; then
      CODEX_MAILBOX_WATCHER="$CODEX_MAILBOX_ROOT/codex-mailbox-watcher.mjs"
      CODEX_NATIVE_MAILBOX=true
    else
      echo "Warning: native Codex mailbox delivery is unavailable." >&2
      if [ "$MAILBOX_POKE_PROVIDER_AWARE" = "true" ] && [ -n "$NODE_BIN" ]; then
        echo "Upgrade or reinstall the dfrysinger/skills plugin; using the guarded tmux fallback." >&2
      else
        echo "Upgrade or reinstall the dfrysinger/skills plugin; mailbox envelopes will remain pending." >&2
      fi
    fi
  fi
fi

poke_mailbox() {
  if [ "$MAILBOX_POKE_PROVIDER_AWARE" = "true" ]; then
    "$MAILBOX_POKE" "$MAILBOX_SELF_ADDRESS" --tmux-session "$SESSION" "$@"
  else
    "$MAILBOX_POKE" "$SESSION" "$@"
  fi
}

# ---- carry-over prompt -----------------------------------------------------
# Seeds a freshly rotated session with instructions to rebuild context from the
# retired one by reference, rather than by replaying its transcript. Emitted as
# a single line so it can be typed into the CLI input with tmux send-keys.

build_carryover_prompt() {
  local old="$1"
  local ss="$HOME/.copilot/session-state"
  cat <<EOF | tr '\n' ' '
You are continuing work from session $old, which was retired because its
transcript grew too large to reload. Before anything else, rebuild context from
it, skipping quietly over whatever does not exist: read $ss/$old/plan.md; read
the two newest files in $ss/$old/checkpoints/; list $ss/$old/files/; run
sqlite3 $ss/$old/session.db "SELECT id,title,status FROM todos WHERE status !=
'done'" for unfinished work; and read the tail of the conversation with the
session_store_sql tool using source=local: SELECT
turn_index,user_message,assistant_response FROM turns WHERE session_id='$old'
ORDER BY turn_index DESC LIMIT 12. Then summarize where things stand and what
you believe the next step is, and wait for my go-ahead before acting.
EOF
}

# ---- tmux client safety guards --------------------------------------------

# The tmux server is single threaded: one client it cannot write to blocks the
# event loop and freezes every session. Two invocations cause that, so both are
# refused below rather than attached.

# Inside a pane of this same tmux server. $TMUX alone is not enough, because
# callers sometimes blank it to bypass tmux's own nesting guard; compare the
# controlling terminal against the server's pane ttys as well.
inside_tmux() {
  [ -n "${TMUX:-}" ] && return 0
  _tty=$(tty 2>/dev/null) || return 1
  [ "${_tty#/dev/}" = "$_tty" ] && return 1
  tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | grep -qx "$_tty"
}

# Attaching with stdout on a pipe creates a client tmux can block writing to
# once nobody drains it.
require_terminal() {
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "agent-stack: refusing to attach '$SESSION' without a terminal." >&2
    echo "agent-stack: this would wedge the tmux server. Run it from an interactive" >&2
    echo "agent-stack: shell, or inspect the session with:" >&2
    echo "agent-stack:   tmux capture-pane -p -t $SESSION" >&2
    exit 1
  fi
}

# Resolve an existing directory through symlinks and platform aliases.
physical_path() {
  [ -n "${1:-}" ] || return 1
  (cd "$1" 2>/dev/null && pwd -P)
}

session_matches_workspace() {
  local session="$1" session_path expected_path actual_path
  session_path="$(tmux display-message -p -t "=$session:" '#{session_path}' 2>/dev/null)" ||
    return 1
  [ -n "$session_path" ] || return 1
  expected_path="$(physical_path "$DIR")" || return 1
  actual_path="$(physical_path "$session_path")" || return 1
  [ "$actual_path" = "$expected_path" ]
}

refuse_mismatched_session() {
  local session="$1" session_path expected_path actual_path
  session_path="$(tmux display-message -p -t "=$session:" '#{session_path}' 2>/dev/null || true)"
  expected_path="$(physical_path "$DIR" 2>/dev/null || printf '%s' "$DIR")"
  actual_path="$(physical_path "$session_path" 2>/dev/null || printf '%s' "${session_path:-unknown}")"
  echo "tmux session '$session' belongs to another workspace." >&2
  echo "  session workspace: $actual_path" >&2
  echo "  expected workspace: $expected_path" >&2
  echo "Choose another name, or explicitly remove or rename the conflicting tmux session." >&2
  exit 1
}

# ---- attach if session exists ---------------------------------------------

# A short-lived pre-release used copilot-<name>. Prefer the stable unprefixed
# Copilot namespace for new sessions, but keep those live sessions attachable
# until they are naturally retired.
if [ "$BACKEND" = "copilot" ] &&
   ! tmux has-session -t "=$NAME" 2>/dev/null &&
   tmux has-session -t "=copilot-$NAME" 2>/dev/null; then
  if session_matches_workspace "copilot-$NAME"; then
    SESSION="copilot-$NAME"
  fi
fi

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  session_matches_workspace "$SESSION" || refuse_mismatched_session "$SESSION"
  if [ -n "$MAILBOX_POKE" ] && [ "$CODEX_NATIVE_MAILBOX" != "true" ]; then
    ( poke_mailbox ) &
  fi
  if inside_tmux; then
    exec tmux switch-client -t "=$SESSION"
  fi
  require_terminal
  exec tmux attach -t "=$SESSION"
fi

# ---- new session -----------------------------------------------------------

if [ "$BACKEND" = "copilot" ]; then
  case "$COPILOT_TASK_WAIT_TIMEOUT_SECONDS" in
    *[!0-9]*|"")
      echo "COPILOT_TASK_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
      exit 2
      ;;
    *[1-9]*) ;;
    *)
      echo "COPILOT_TASK_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
      exit 2
      ;;
  esac
fi

# ---- build backend-specific launch command --------------------------------

CMD=""
case "$BACKEND" in
  copilot)
    # Session-ID strategy: we want one Copilot session per agent name, with
    # no interactive picker. Copilot CLI accepts --session-id=<uuid> which
    # means "resume by ID, or set the UUID for a new session". So we pick a
    # UUID up front and Copilot does the right thing.
    #
    # UUID resolution, in priority order:
    #   1. Scan ~/.copilot/session-state/*/workspace.yaml for an existing
    #      session whose `cwd:` equals $DIR (the wrapper's canonical
    #      workspace). Prefer sessions with summary_count > 0 (i.e., real
    #      work has happened) over empty placeholder sessions; within each
    #      tier, pick the one with the most recent updated_at.
    #
    #      We key on cwd, NOT on the `name:` field: Copilot CLI's
    #      auto-summarizer rewrites `name:` in place whenever
    #      `user_named:` is false (e.g., after a `/clear`), so a session
    #      that originally was named "kilo" can end up named
    #      "Review Chat Transcript" — which would slip past a name match
    #      and leave us starting a brand-new empty session instead of
    #      resuming the real one.
    #
    #      Within each tier (real and empty), latest `updated_at` wins —
    #      i.e., the session most recently active. `updated_at` is bumped
    #      by real activity inside Copilot CLI (user messages, tool calls,
    #      summarizer runs), not by `tmux attach` (which only reconnects
    #      the terminal without restarting the running copilot process).
    #      So `updated_at` reliably identifies the session the user was
    #      last working in, which is what `ca` should resume — including
    #      across `/new` (the new session promotes itself by being the
    #      one with fresh activity).
    #
    #   2. Otherwise, fall back to a deterministic UUIDv5 derived from the
    #      name, so the first wrapper launch creates a stable UUID and
    #      subsequent launches resume it.
    UUID=""
    SESSION_STATE_DIR="$HOME/.copilot/session-state"
    RETIRED_FILE="$DIR/.ca-retired-sessions"
    if [ -d "$SESSION_STATE_DIR" ]; then
      UUID="$(python3 - "$SESSION_STATE_DIR" "$DIR" "$RETIRED_FILE" <<'PY'
import json
import os
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

root, workspace, retired_file = sys.argv[1:]
root = os.path.abspath(root)
started = last_progress = time.monotonic()
print("Scanning Copilot session metadata (checking cache, 8 parallel readers)...",
      file=sys.stderr, flush=True)
try:
    with open(retired_file, encoding="utf-8", errors="replace") as stream:
        retired = set(stream.read().splitlines())
except FileNotFoundError:
    retired = set()

with os.scandir(root) as entries:
    directories = sorted(
        entry.path for entry in entries
        if not entry.name.startswith(".") and entry.is_dir()
    )
field_names = {"cwd", "id", "updated_at", "summary_count"}
cache_path = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "remote-agent-stack", "copilot-sessions-v1.json")

def load_cache():
    try:
        with open(cache_path, encoding="utf-8") as stream:
            data = json.load(stream)
        if (not isinstance(data, dict) or type(data.get("version")) is not int
                or data["version"] != 1 or data.get("root") != root
                or not isinstance(data.get("entries"), dict)):
            raise ValueError("incompatible cache")
        for name, entry in data["entries"].items():
            if (not name or name.startswith(".") or os.path.basename(name) != name
                    or not isinstance(entry, dict)
                    or not isinstance(entry.get("signature"), list)
                    or len(entry["signature"]) != 5
                    or any(type(value) is not int for value in entry["signature"])
                    or not isinstance(entry.get("fields"), dict)
                    or not entry["fields"].keys() <= field_names
                    or any(not isinstance(value, str) for value in entry["fields"].values())):
                raise ValueError("invalid cache entry")
        return data["entries"]
    except FileNotFoundError:
        return None
    except (OSError, ValueError, RecursionError):
        print("  Session cache unavailable or invalid; reading metadata.",
              file=sys.stderr, flush=True)
        return None

def signature(path):
    stat = os.stat(path)
    return [stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns]

def read_fields(directory, only_workspace=None):
    fields = {}
    try:
        with open(os.path.join(directory, "workspace.yaml"),
                  encoding="utf-8", errors="replace") as stream:
            for line in stream:
                key, separator, value = line.partition(": ")
                if separator and key in field_names:
                    fields.setdefault(key, value.rstrip())
                    if (len(fields) == 4 or
                            (only_workspace is not None and
                             fields.get("cwd", only_workspace) != only_workspace)):
                        break
    except (FileNotFoundError, PermissionError, IsADirectoryError):
        return None
    return fields

cache = load_cache()

def read_session(directory):
    path = os.path.join(directory, "workspace.yaml")
    old = (cache or {}).get(os.path.basename(directory))
    for _ in range(2):
        try:
            before = signature(path)
            if old is not None and old["signature"] == before:
                return old, "reused"
            fields = read_fields(directory)
            if fields is None:
                return None, "skipped"
            if before == signature(path):
                return {"signature": before, "fields": fields}, "read"
        except (FileNotFoundError, PermissionError, IsADirectoryError):
            return None, "skipped"
    return None, "unstable"

def ranked_session(fields):
    if fields is None:
        return None
    session_id = fields.get("id", "")
    if fields.get("cwd") != workspace or not session_id or session_id in retired:
        return None
    rank = (fields.get("summary_count", "") not in ("", "0"),
            fields.get("updated_at", ""))
    return rank, session_id

def publish_cache(entries):
    temporary = None
    try:
        parent = os.path.dirname(cache_path)
        os.makedirs(parent, mode=0o700, exist_ok=True)
        with tempfile.NamedTemporaryFile(
                mode="w", encoding="utf-8", dir=parent,
                prefix=".copilot-sessions-", suffix=".tmp", delete=False) as stream:
            temporary = stream.name
            json.dump({"version": 1, "root": root, "entries": entries}, stream)
        os.replace(temporary, cache_path)
    except OSError:
        print("  Session cache could not be saved; using fresh metadata.",
              file=sys.stderr, flush=True)
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except OSError:
                pass

selected = ""
best = None
entries = {}
counts = dict.fromkeys(("reused", "read", "skipped", "unstable"), 0)
with ThreadPoolExecutor(max_workers=8) as readers:
    # Consume in directory order so equal-ranked sessions retain the same winner.
    for index, (entry, state) in enumerate(readers.map(read_session, directories), 1):
        counts[state] += 1
        if entry is not None:
            entries[os.path.basename(directories[index - 1])] = entry
        result = ranked_session(entry["fields"] if entry is not None else None)
        now = time.monotonic()
        if now - last_progress >= 2:
            print(f"  Scanned {index:,}/{len(directories):,} session directories...",
                  file=sys.stderr, flush=True)
            last_progress = now
        if result is not None:
            rank, session_id = result
            if best is None or rank > best:
                selected, best = session_id, rank

if counts["unstable"]:
    print("  Metadata changed during lookup; using an uncached scan.",
          file=sys.stderr, flush=True)
    selected, best = "", None
    counts = dict.fromkeys(("reused", "read", "skipped", "unstable"), 0)
    with ThreadPoolExecutor(max_workers=8) as readers:
        for fields in readers.map(lambda directory: read_fields(directory, workspace), directories):
            counts["skipped" if fields is None else "read"] += 1
            result = ranked_session(fields)
            if result is not None:
                rank, session_id = result
                if best is None or rank > best:
                    selected, best = session_id, rank
            now = time.monotonic()
            if now - last_progress >= 2:
                print("  Uncached session scan in progress...", file=sys.stderr, flush=True)
                last_progress = now
elif entries != cache:
    publish_cache(entries)

print(f"Session scan complete: {len(directories):,} directories in "
      f"{time.monotonic() - started:.1f}s "
      f"({counts['reused']:,} reused, {counts['read']:,} read, "
      f"{counts['skipped']:,} skipped).", file=sys.stderr, flush=True)
print(selected)
PY
)"
    fi

    if [ -z "$UUID" ]; then
      UUID="$(python3 -c "import uuid,sys; print(uuid.uuid5(uuid.NAMESPACE_URL, 'remote-agent-stack/'+sys.argv[1]))" "$NAME")"
    fi

    # ---- offer to retire an oversized session ------------------------------
    # Copilot reloads a session's whole event log on resume, so one carried for
    # weeks grows into the gigabytes and drags on startup. Offer a fresh
    # session that inherits context by reference. Nothing is ever deleted — the
    # retired session stays on disk, resumable and minable.
    CARRYOVER_PROMPT=""
    _events="$SESSION_STATE_DIR/$UUID/events.jsonl"
    if [ -t 0 ] && [ "${SESSION_WARN_MB:-300}" -gt 0 ] && [ -r "$_events" ]; then
      _mb=$(( $(wc -c < "$_events") / 1048576 ))
      if [ "$_mb" -ge "${SESSION_WARN_MB}" ]; then
        echo "" >&2
        echo "Session for '$NAME' has grown to ${_mb} MB." >&2
        echo "  $UUID" >&2
        echo "Copilot replays the whole event log on resume, so this one will be slow" >&2
        echo "to start. Starting fresh keeps it on disk and carries context forward." >&2
        printf "Start a fresh session? [y/N/q] " >&2
        read -r _ans < /dev/tty || _ans=""
        case "$_ans" in
          q|Q) echo "Aborted." >&2; exit 0 ;;
          y|Y)
            _old="$UUID"
            printf '%s\n' "$_old" >> "$RETIRED_FILE"
            UUID="$(uuidgen | tr 'A-Z' 'a-z')"
            CARRYOVER_PROMPT="$(build_carryover_prompt "$_old")"
            echo "Retired $_old — starting fresh session $UUID." >&2
            ;;
        esac
      fi
    fi

    # Launch by --session-id alone, which Copilot treats as "resume this
    # session, or create it if the UUID is new" — so one command covers both
    # the first launch and every resume. We deliberately do NOT pass --name:
    # recent Copilot CLI rejects --name together with a --session-id that
    # resolves to an existing or remote session (i.e. every resume, plus a
    # cross-machine first launch that resolves to a remote session), and --name
    # is only a cosmetic label on the session anyway. Resume never relies on it
    # — the scan above keys on `cwd`, not `name`, precisely because Copilot's
    # auto-summarizer rewrites session names in place.
    CMD="env MAILBOX_SELF_ADDRESS='$MAILBOX_SELF_ADDRESS' COPILOT_TASK_WAIT_TIMEOUT_SECONDS='$COPILOT_TASK_WAIT_TIMEOUT_SECONDS' $AGENT_BIN --session-id='$UUID'"
    if [ "${ALLOW_ALL:-false}" = "true" ]; then
      CMD="$CMD --allow-all"
    fi
    ;;

  claude)
    # Claude Code stores per-project sessions at
    #   ~/.claude/projects/<slug>/*.jsonl
    # where <slug> is the working directory with `/` replaced by `-`
    # (leading `-` included). Resume the most recent session with
    # `claude --continue` when at least one session file exists;
    # otherwise start a fresh session.
    PROJECT_SLUG="$(printf '%s' "$DIR" | sed 's|/|-|g')"
    PROJECT_DIR="$HOME/.claude/projects/$PROJECT_SLUG"
    HAS_SESSION=false
    if [ -d "$PROJECT_DIR" ]; then
      for _f in "$PROJECT_DIR"/*.jsonl; do
        [ -r "$_f" ] && { HAS_SESSION=true; break; }
      done
    fi

    CMD="env -u COPILOT_TASK_WAIT_TIMEOUT_SECONDS MAILBOX_SELF_ADDRESS='$MAILBOX_SELF_ADDRESS' $AGENT_BIN"
    if [ -n "$CLAUDE_MAILBOX_SETTINGS_ARG" ]; then
      CMD="$CMD --settings $CLAUDE_MAILBOX_SETTINGS_ARG"
    fi
    if [ "$HAS_SESSION" = "true" ]; then
      CMD="$CMD --continue"
    fi
    if [ "${ALLOW_ALL:-false}" = "true" ]; then
      CMD="$CMD --dangerously-skip-permissions"
    fi
    ;;

  codex)
    HAS_SESSION=false
    CODEX_SESSIONS_DIR="$HOME/.codex/sessions"
    if [ -d "$CODEX_SESSIONS_DIR" ] &&
       python3 - "$CODEX_SESSIONS_DIR" "$DIR" <<'PY'
import json
import os
import sys

root, expected_cwd = sys.argv[1:]
for directory, _, files in os.walk(root):
    for filename in files:
        if not filename.endswith(".jsonl"):
            continue
        path = os.path.join(directory, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                record = json.loads(stream.readline())
        except (OSError, UnicodeError, json.JSONDecodeError):
            continue
        payload = record.get("payload") if isinstance(record, dict) else None
        cwd = payload.get("cwd") if isinstance(payload, dict) else None
        if cwd is None and isinstance(record, dict):
            cwd = record.get("cwd")
        if cwd == expected_cwd:
            raise SystemExit(0)
raise SystemExit(1)
PY
    then
      HAS_SESSION=true
    fi

    if [ "$CODEX_NATIVE_MAILBOX" = "true" ]; then
      printf -v _agent_q '%q' "$0"
      printf -v _codex_q '%q' "$(command -v "$AGENT_BIN")"
      printf -v _node_q '%q' "$NODE_BIN"
      printf -v _watcher_q '%q' "$CODEX_MAILBOX_WATCHER"
      printf -v _workspace_q '%q' "$DIR"
      printf -v _address_q '%q' "$MAILBOX_SELF_ADDRESS"
      _codex_allow_all=false
      [ "${ALLOW_ALL:-false}" = "true" ] && _codex_allow_all=true
      printf -v _allow_all_q '%q' "$_codex_allow_all"
      printf -v _has_session_q '%q' "$HAS_SESSION"
      CMD="env -u COPILOT_TASK_WAIT_TIMEOUT_SECONDS $_agent_q --internal-codex-mailbox-launch"
      CMD="$CMD $_codex_q $_node_q $_watcher_q $_workspace_q $_address_q"
      CMD="$CMD $_allow_all_q $_has_session_q"
    else
      CMD="env -u COPILOT_TASK_WAIT_TIMEOUT_SECONDS MAILBOX_SELF_ADDRESS='$MAILBOX_SELF_ADDRESS' $AGENT_BIN"
      if [ "$HAS_SESSION" = "true" ]; then
        CMD="$CMD resume --last"
      fi
      if [ "${ALLOW_ALL:-false}" = "true" ]; then
        CMD="$CMD --dangerously-bypass-approvals-and-sandbox"
      fi
    fi
    ;;
esac

# Unlock the login keychain so credential helpers (git, gh, etc.) work in
# this SSH/tmux session. Done last so any interactive prompt above is settled
# before the password prompt appears. Quietly skipped if not on macOS.
if [ -f "$HOME/Library/Keychains/login.keychain-db" ] && command -v security >/dev/null 2>&1; then
  echo "Unlocking the login keychain; enter its password here if prompted." >&2
  security unlock-keychain "$HOME/Library/Keychains/login.keychain-db" || true
fi

echo "Starting $BACKEND in tmux session '$SESSION'..." >&2
if [ -n "$MAILBOX_POKE" ] && [ "$CODEX_NATIVE_MAILBOX" != "true" ]; then
  ( poke_mailbox --wait ) &
fi

# Type the carry-over prompt once the CLI is up. A single Enter often fails to
# submit in Copilot's input box, so press it until the input box is empty.
# The box spans the region between the last two horizontal rules; a long prompt
# wraps below the `❯` marker, so the whole region has to be checked rather than
# just the marker line.
_input_is_empty() {
  tmux capture-pane -p -t "$1" 2>/dev/null | awk '
    /^─+$/ { n++; sep[n] = NR }
    { line[NR] = $0 }
    END {
      if (n < 2) exit 1
      for (i = sep[n-1] + 1; i < sep[n]; i++) {
        t = line[i]; sub(/❯/, "", t); gsub(/[[:space:]]/, "", t)
        if (t != "") exit 1
      }
      exit 0
    }'
}

if [ -n "${CARRYOVER_PROMPT:-}" ]; then
  (
    for _ in $(seq 1 120); do
      if tmux has-session -t "$SESSION" 2>/dev/null && \
         tmux capture-pane -p -t "$SESSION" 2>/dev/null | tail -10 | grep -q '❯'; then
        break
      fi
      sleep 0.5
    done
    sleep 1
    tmux send-keys -t "$SESSION" -l -- "$CARRYOVER_PROMPT"
    sleep 0.5
    for _ in $(seq 1 10); do
      tmux send-keys -t "$SESSION" Enter
      sleep 1.5
      _input_is_empty "$SESSION" && break
    done
  ) &
fi

if inside_tmux; then
  tmux new-session -d -s "$SESSION" -c "$DIR" \; send-keys -t "$SESSION" "$CMD" Enter
  exec tmux switch-client -t "$SESSION"
fi

require_terminal
exec tmux new-session -s "$SESSION" -c "$DIR" \; send-keys "$CMD" Enter
